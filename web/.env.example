# Copy to .env.local for local dev; set the same keys in Vercel for production.
# All vars here are server-only (read in middleware, API routes, and server
# components). None need the NEXT_PUBLIC_ prefix — no Supabase calls happen
# in the browser.

# --- Supabase (auth + Postgres) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret (Dashboard → Settings → API → JWT Secret). Used to mint short-lived
# user sessions for API-key requests (P3-01). Must be the symmetric HS256 secret.
SUPABASE_JWT_SECRET=

# --- Auth allowlist (P1-02) ---
# Only this email may complete login; all others are rejected in middleware.
ALLOWED_EMAIL=jacobbaron@gmail.com

# --- Cloudflare R2 (storage + presigned uploads, P1-04) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- OpenAI (Whisper transcription, P1-06) ---
OPENAI_API_KEY=

# --- Anthropic (Claude story generation, P2-02) ---
ANTHROPIC_API_KEY=

# --- Modal (heavy compute tasks, P1-06/07/11/P2-02) ---
# Vercel API routes invoke deployed Modal web endpoints; auth via shared secret.
# MODAL_TOKEN_ID and MODAL_TOKEN_SECRET are only needed when running
# `modal deploy` from the CLI — not used at Vercel runtime.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WEBHOOK_SECRET=
# URLs printed by `modal deploy modal/app.py` for each endpoint.
MODAL_TRANSCRIBE_URL=
MODAL_ALIGN_URL=
MODAL_RENDER_URL=
MODAL_GENERATE_URL=
