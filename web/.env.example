# Copy to .env.local for local dev; set the same keys in Vercel for production.
# All vars here are server-only (read in middleware, API routes, and server
# components). None need the NEXT_PUBLIC_ prefix — no Supabase calls happen
# in the browser.

# --- Supabase (auth + Postgres) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth allowlist (P1-02) ---
# Only this email may complete login; all others are rejected in middleware.
ALLOWED_EMAIL=jacobbaron@gmail.com

# --- Cloudflare R2 (storage + presigned uploads, P1-04) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# --- Modal (heavy compute tasks, P1-06/07/11) ---
# Vercel API routes invoke deployed Modal web endpoints; auth via shared secret.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WEBHOOK_SECRET=
