# Copy to .env.local for local dev; set the same keys in Vercel for production.
# Values prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets there.

# --- Supabase (auth + Postgres) ---
# Project URL and anon key are safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is server-only (API routes / Modal). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth allowlist (P1-02) ---
# Only this email may complete login; all others are rejected in middleware.
ALLOWED_EMAIL=jacobbaron@gmail.com

# --- Cloudflare R2 (storage + presigned uploads, P1-04) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Modal (heavy compute tasks, P1-06/07/11) ---
# Vercel API routes invoke deployed Modal web endpoints; auth via shared secret.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WEBHOOK_SECRET=
